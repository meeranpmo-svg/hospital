# Copy this file to `.env` on the VPS (or wherever you deploy):
#   cp .env.example .env
#   nano .env

# ─── HOST_PORT (used by docker-compose.yml) ─────────────────────────────────
# Host port the hospital-erp container binds to. The container itself always
# serves on port 80 internally; this is the port your reverse proxy (Nginx
# Proxy Manager, Traefik, etc.) — or your browser, for direct access — will
# connect to.
#
# Examples:
#   3000   default — handy for local Docker testing  (http://localhost:3000)
#   8086   typical free port on a VPS already running other apps
HOST_PORT=8086

# ─── Caddy stack only (used by docker-compose.prod.yml) ─────────────────────
# Skip this section if you're using an external reverse proxy like NPM.
#
# SITE_ADDRESS — where Caddy listens:
#   :80                       → plain HTTP, any host
#   hospital.example.com      → automatic HTTPS via Let's Encrypt
SITE_ADDRESS=:80

# Email Let's Encrypt sends cert renewal notices to (real address).
ACME_EMAIL=admin@example.com
