# Copy this file to `.env` on the VPS and edit the values:
#   cp .env.example .env
#   nano .env

# ─── SITE_ADDRESS ──────────────────────────────────────────────────────────
# Where Caddy listens. Two common cases:
#
#   :80                       → plain HTTP on port 80, any host (no TLS)
#                               Use when you only have an IP, no domain yet.
#                               Site reachable at:  http://<your-vps-ip>
#
#   hospital.example.com      → HTTPS automatically provisioned via
#                               Let's Encrypt (free). Domain MUST already
#                               point to this VPS's IP via an A record.
#                               Site reachable at:  https://hospital.example.com
#
SITE_ADDRESS=:80

# ─── ACME_EMAIL ────────────────────────────────────────────────────────────
# Email Let's Encrypt sends cert renewal notices to. Only used when
# SITE_ADDRESS is a domain (not :80). Use a real address you check.
ACME_EMAIL=admin@example.com
